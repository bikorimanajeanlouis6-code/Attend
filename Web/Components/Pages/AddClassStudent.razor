@using Application.Services.ClassStudentServices
@using Application.Services.StudentServices
@using Application.Services.ClassServices
@using Application.DTOs
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IStudentService StudentService
@inject IClassService ClassService
@inject IClassStudentService ClassStudentService
@inject IDialogService DialogService
@page "/classStudent/add"

 <MudDialog>
    <TitleContent>Add Class_Student</TitleContent>
    <DialogContent>
        <EditForm Model="classstudent" OnValidSubmit="SaveClassStudentAsync">
           <MudGrid>
              
            <MudItem xs="12">
                @* <MudSelect
                Adornment="Adornment.End"
                Immediate="true"
                 Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 AdornmentIcon="@Icons.Material.Filled.Person"
                 Label="Class"
                  @bind-value="classstudent.ClasssId">
                    
                    
                    <MudSelectItem Value="0" Label="Select Class"></MudSelectItem>
                         @if (Classs != null)
                         {
                            foreach (var c in Classs)
                            {
                                <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                            }
                         }
                </MudSelect> 
            </MudItem>  *@
    
        
            <MudAutocomplete T="GetStudentDTO"
                             @bind-Value="selectedStudent"
                             ToStringFunc="@(s => s?.Name ?? string.Empty)"
                             SearchFunc="Search"
                             Margin="Margin.Dense"
                             Variant="Variant.Outlined"
                             Label="Student"
                             Placeholder="Select Student" />
            </MudItem>

           
            <MudItem xs="12">
                <MudSelect 
                         Adornment="Adornment.End"
                         Immediate="true"
                         AdornmentIcon="@Icons.Material.Filled.Person"
                         Margin="Margin.Dense"
                         Variant="Variant.Outlined"
                         Label="Class" 
                         @bind-value="classstudent.ClasssId">
                            
                            <MudSelectItem Value="0" Label="Select Class"></MudSelectItem>
                                @if (Classs != null)
                                {
                                    foreach (var c in Classs)
                                    {
                                        <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                                    }
                                }
                </MudSelect>
            </MudItem>


            <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>

@code
    {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private AddClassStudentDTO classstudent = new ();

    private List<GetClassDTO> Classs = new();
    private List<GetStudentDTO> Student = new();
    private GetStudentDTO? selectedStudent;
    @* private string GetStudentName(int studentId) => Student.FirstOrDefault(s => s.Id == studentId)?.Name ?? string.Empty; *@
    //students is name Lis<GetStudentDTO>
    protected override async Task OnInitializedAsync()
    {


            var c = await ClassService.GetAllClassesAsync();
            if (Classs != null)
            {
            Classs=c;
            StateHasChanged();
            }

            var st = await StudentService.GetAllStudentsAsync();
            if (st != null)
            {
            Student=st;
            StateHasChanged();
            }
    }

    private async Task<IEnumerable<GetStudentDTO>> Search(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
        {
            return Student;
        }

        return Student.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }


    private async Task SaveClassStudentAsync()
    {
        if (selectedStudent is not null)
        {
            classstudent.StudentId = selectedStudent.Id;
        }

        await ClassStudentService.AddClassStudentAsync(classstudent);
        MudDialog.Close(DialogResult.Ok(true));
    }
}