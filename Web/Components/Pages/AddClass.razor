@using Application.DTOs
@using Application.Services.ClassServices
@using Application.Services.EducationLevelServices
@using Application.Services.FacultyServices

@rendermode InteractiveServer
@inject NavigationManager navigation
@inject IClassService ClassService
@inject IFacultyService FacultyService
@inject IEducationLevelService EducationLevelService
@page "/class/add"
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>Add Class</TitleContent>
    <DialogContent>
        <EditForm Model="classs" OnValidSubmit="SaveClassAsync">
           <MudGrid>
            <MudItem xs="12">
                <MudTextField 
                @bind-Value="classs.Name"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Placeholder="Class Name">
                </MudTextField>
            </MudItem>
            
           
            <MudItem xs="12">
                <MudSelect Label="Faculty" @bind-value="classs.FacultyId" Variant="Variant.Outlined" >
                    
                    
                    <MudSelectItem Value="0" Label="Select faculty"></MudSelectItem>
                         @if (faculty != null)
                         {
                            foreach (var fac in faculty)
                            {
                                <MudSelectItem Value="@fac.Id">@fac.Name</MudSelectItem>
                            }
                         }
                </MudSelect>
            </MudItem>
           
            <MudItem xs="12">
                <MudSelect Label="Education level" @bind-value="classs.EducationLevelId" Variant="Variant.Outlined">
                    
                    <MudSelectItem Value="0" Label="Select Education level"></MudSelectItem>
                         @if (educationlevel != null)
                         {
                            foreach (var edu  in educationlevel)
                            {
                                <MudSelectItem Value="@edu.Id">@edu.Name</MudSelectItem>
                            }
                         }
                    
                </MudSelect>
            </MudItem>

             <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>
  



 @code{
      [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private AddClassDTO classs = new ();
   
    
    
    private List<GetFacultyDTO> faculty = new();
    private List<GetEducationLevelDTO> educationlevel = new();

    protected override async Task OnInitializedAsync()
    {

            var fac = await FacultyService.GetAllFacultyAsync();
            if (faculty != null)
            {
            faculty=fac;
            StateHasChanged();
            }

            var edu = await EducationLevelService.GetAllEducationLevelAsync();
            if (edu != null)
            {
            educationlevel=edu;
            StateHasChanged();
            }

    }
    private async Task SaveClassAsync()
    {
      try
      {
        await ClassService.AddClassAsync(classs);
        MudDialog.Close(DialogResult.Ok(true));
        Snackbar.Add("Added Successfully", Severity.Success);
      }
      catch (Exception ex)
      {
        Snackbar.Add(ex.Message ,Severity.Error);
      }
    }
   
}
