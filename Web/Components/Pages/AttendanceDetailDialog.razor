@using Application.DTOs
@using Application.Services.AttendanceServices

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject NavigationManager NavigationManager

@inject IAttendanceService AttendanceService


<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BackToList" StartIcon="@Icons.Material.Filled.ArrowBack">Back to List</MudButton>
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2"/> Attendence Details
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (Attendance == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Class details could not be found.</MudText>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Class ID</MudText>
                    <MudText Typo="Typo.body1">@Attendance.Id</MudText>
                </MudItem>
               
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Instractor Name</MudText>
                    <MudText Typo="Typo.body1">@Attendance.InstructorName</MudText>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; }

    [Parameter] 
    public int Id { get; set; } 

    private bool isLoading = true;
    private GetAttendanceDTO  Attendance;

    protected override async Task OnParametersSetAsync()
    { 
        isLoading = true;
        try
        {
            if (Id > 0)
            {
                Attendance = await AttendanceService.GetAttendanceByIdAsync(Id);
            }
        }
        finally
        {
            isLoading = false;
        }
    } 

     private void Close() => MudDialog.Close();
     private void BackToList()
    {
        NavigationManager.NavigateTo("/attendence");
    }
}