@page "/students"

@using Application.Services.StudentServices
@using Application.DTOs
@inject NavigationManager Navigation
@inject IDialogService DialogService
@using Domain.ValueObjects
@inject IStudentService StudentService


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4" >
        <MudDataGrid T="GetStudentDTO" MultiSelection="true" Items="@students" SortMode="SortMode.Multiple" Filterable="true" QuickFilter="@_quickFilter"
            Hideable="true" RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" SelectedItemsChanged="@SelectedItemsChanged">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">Students</MudText>
                <MudSpacer />
                <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-none d-md-flex">
                  <MudTextField 
                    @bind-Value="_searchString" 
                    Placeholder="Search" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    AdornmentIcon="@Icons.Material.Filled.Search" 
                    IconSize="Size.Medium" 
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Class="mt-1 w-100">
                  </MudTextField>
                </MudContainer>

                
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="ml-4" @onclick="() => OpenDialogAsync(_closeButton)" >Add Student</MudButton>
            
            </ToolBarContent>

            <Columns>
                <SelectColumn T="GetStudentDTO" />
                <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" Filterable="false" />
                <PropertyColumn Property="x => x.Name" />
                <PropertyColumn Property="x => x.Sex" SortBy="@_sortBy" />
                <PropertyColumn Property="x => x.DateofBirth" Title="DateofBirth" />
                <PropertyColumn Property="x => x.Phone" Title="Phone" />
                <PropertyColumn Property="x => x.Email" Title="Email" />

                    <TemplateColumn Title="Status">
                              <CellTemplate>
                              <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="@GetStatusColor(context.Item.Status)">
                                 @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                 </TemplateColumn>


                <TemplateColumn Title="Actions">
                     <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" @onclick="() => ViewStudentAsync(context.Item)" />
                         <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" @onclick="() => EditStudentAsync(context.Item)" />
                   
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GetStudentDTO" />
            </PagerContent>

        </MudDataGrid>
</MudContainer>
@code
{
    
        private string _searchString;
        private bool _sortNameByLength;
        private List<string> _events = new();
        private static Color GetStatusColor(StudentStatus status) => status switch
        {
            StudentStatus.Active => Color.Success,
            StudentStatus.Deleted => Color.Error,
            _ => Color.Default
        };
   

              void RowClicked(DataGridRowClickEventArgs<GetStudentDTO> args)
        {
            _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }
        
        void RowRightClicked(DataGridRowClickEventArgs<GetStudentDTO> args)
        {
            _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }

        void SelectedItemsChanged(HashSet<GetStudentDTO> items)
        {
            _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
        }
         private Func<GetStudentDTO, object> _sortBy => x =>
        {
            if (_sortNameByLength)
                return x.Name.Length;
            else
                return x.Name;
        };
        // quick filter - filter globally across multiple columns with the same input
        private Func<GetStudentDTO, bool> _quickFilter => x =>
        {
            if (string.IsNullOrWhiteSpace(_searchString))
                return true;

            if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            if (x.Sex.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            if ($"{x.Phone} {x.Email}".Contains(_searchString))
                return true;

            return false;
        };

        private List<GetStudentDTO> students  = new List<GetStudentDTO>();

       protected override async Task OnInitializedAsync()
        {
            students= await StudentService.GetAllStudentsAsync();


        }
        private readonly DialogOptions _closeButton = new() { CloseButton = true };
        private async Task OpenDialogAsync(DialogOptions options)
        {
            var dialog = await DialogService.ShowAsync<AddStudent>("Add New Student", options);
                
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
            {
                students = await StudentService.GetAllStudentsAsync();
            }
        }

         private async Task ViewStudentAsync(GetStudentDTO student)
            {
                var parameters = new DialogParameters
                {
                    { nameof(StudentDetailDialog.Id), student.Id } // Pass the Id directly
                };

                    var dialog = await DialogService.ShowAsync<StudentDetailDialog>("Student Details", parameters);
            }
           private async Task EditStudentAsync(GetStudentDTO student)
            {
                var parameters = new DialogParameters
                {
                    { nameof(StudentEditDialog.Id), student.Id } // Pass the Id directly
                };

                var dialog = await DialogService.ShowAsync<StudentEditDialog>("Edit Student", parameters);
                
                var result = await dialog.Result;

                if (result is not null && !result.Canceled)
                {
                    students = await StudentService.GetAllStudentsAsync();
                    StateHasChanged();
                }
            }
    
}
        
         
 }    





