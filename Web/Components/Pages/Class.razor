@page "/class"

@using Application.Services.ClassServices
@using Application.DTOs
@using Application.Services.FacultyServices
@using Application.Services.EducationLevelServices
@using Domain.Entities
@using Domain.ValueObjects
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IClassService ClassService
@inject IFacultyService FacultyService

@inject IEducationLevelService EducationLevelService


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4" >
        <MudDataGrid T="GetClassDTO"
         MultiSelection="true"
          Items="@classes" 
          SortMode="SortMode.Multiple"
          Filterable="true" 
          QuickFilter="@_quickFilter"
          Hideable="true" 
          RowClick="@RowClicked" 
          RowContextMenuClick="RowRightClicked"
          SelectedItemsChanged="@SelectedItemsChanged">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">Classes</MudText>
                <MudSpacer />
                <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-none d-md-flex">
                  <MudTextField 
                    @bind-Value="_searchString" 
                    Placeholder="Search" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    AdornmentIcon="@Icons.Material.Filled.Search" 
                    IconSize="Size.Medium" 
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Class="mt-1 w-100">
                  </MudTextField>
                </MudContainer>

                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="ml-4" @onclick="() => OpenDialogAsync(_closeButton)" >Add Class</MudButton>
            
            </ToolBarContent>

            <Columns>
                <SelectColumn T="GetClassDTO" />
                <PropertyColumn Property="x => x.Id" Title="Nr" Sortable="true" Filterable="false" />
                <PropertyColumn Property="x => x.Name" />
                <PropertyColumn Property="x => x.EducationLevel.Name" SortBy="@_sortBy" />
                <PropertyColumn Property="x => x.Faculty.Name" />
                 <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="@GetStatusColor(context.Item.Status)">
                                 @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                 </TemplateColumn>

                 <TemplateColumn Title="Actions">
                     <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" @onclick="() => ViewClassAsync(context.Item)" />
                         <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" @onclick="() => EditClassAsync(context.Item)" />
                         <TemplateColumn Title="Status">
                    
                </TemplateColumn>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GetClassDTO" />
            </PagerContent>

        </MudDataGrid>
</MudContainer>

@code
{
   
   private string _searchString = string.Empty;
        private bool _sortNameByLength;
        private List<string> _events = new();
       
        private List<Faculty> faculties = new();
        private List<EducationLevel> educationLevels = new();

          private static Color GetStatusColor(ClassStatus status) => status switch
        {
            ClassStatus.Active => Color.Success,
            ClassStatus.Full => Color.Warning,
            ClassStatus.Ongoing => Color.Info,
            ClassStatus.Deleted => Color.Error,
            _ => Color.Default
        };
   

        void RowClicked(DataGridRowClickEventArgs<GetClassDTO> args)
        {
            _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }
        
        void RowRightClicked(DataGridRowClickEventArgs<GetClassDTO> args)
        {
            _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }

        void SelectedItemsChanged(HashSet<GetClassDTO> items)
        {
            _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
        }


        private Func<GetClassDTO, object> _sortBy => x =>
        {
            if (_sortNameByLength)
                return x.Name.Length;
            else
                return x.Name;
        };
        // quick filter - filter globally across multiple columns with the same input
        private Func<GetClassDTO, bool> _quickFilter => x =>
        {
            if (string.IsNullOrWhiteSpace(_searchString))
                return true;

            if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            if (x.EducationLevelId.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            if (x.FacultyId.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            return false;
        };
    private List<GetClassDTO> classes = new List<GetClassDTO>();
        protected override async Task OnInitializedAsync()
    {
        classes= await ClassService.GetAllClassesAsync();
    }

     private readonly DialogOptions _closeButton = new() { CloseButton = true };
        private async Task OpenDialogAsync(DialogOptions options)
        {
            var dialog = await DialogService.ShowAsync<AddClass>("Add New Class", options);
                
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
            {
                 classes= await ClassService.GetAllClassesAsync();
            }
        }
         private async Task ViewClassAsync(GetClassDTO Class )
            {
                var parameters = new DialogParameters
                {
                    { nameof(ClassDetailDialog.Id), Class.Id } // Pass the Id directly
                };

              var dialog = await DialogService.ShowAsync<ClassDetailDialog>("Class Details", parameters);

            }
              private async Task EditClassAsync(GetClassDTO Class)
            {
                var parameters = new DialogParameters
                {
                    { nameof(ClassEditDialog.Id), Class.Id } // Pass the Id directly
                };

                var dialog = await DialogService.ShowAsync<ClassEditDialog>("Edit Class", parameters);
                
                var result = await dialog.Result;

                if (result is not null && !result.Canceled)
                {
                    classes = await ClassService.GetAllClassesAsync();
                    StateHasChanged();
                }
            } 
    

}