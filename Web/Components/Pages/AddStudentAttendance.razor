@using Application.DTOs
@using Application.Services.StudentAttendanceServices
@using Application.Services.StudentServices
@using Application.Services.AttendanceServices
@inject NavigationManager Navigation
@using Infrastructure.Migrations
@using Domain.ValueObjects
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IStudentService StudentService
@inject IAttendanceService AttendanceService
@inject IStudentAttendanceService StudentAttendanceService

<MudDialog>
    <TitleContent>Add Student Attendance</TitleContent>
    <DialogContent>
        <EditForm Model="studentattendance" OnValidSubmit="SaveStudentAttendanceAsync">
            <MudGrid>
               
                <MudItem xs="12">
                    <MudSelect Label="Student" @bind-value="studentattendance.StudentId" Margin="Margin.Dense"
                               Variant="Variant.Outlined" Placeholder="Student">
                        <MudSelectItem Value="0" Label="Select Student">Student</MudSelectItem>
                        @if (student != null)
                        {
                            foreach (var std in student)
                            {
                                <MudSelectItem Value="@std.Id">@std.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudSelect Label="Attendance" @bind-value="studentattendance.AttendanceId" Margin="Margin.Dense"
                               Variant="Variant.Outlined" Placeholder="Attendance">
                        <MudSelectItem Value="0" Label="Select Attendance">Attendance</MudSelectItem>
                        @if (attendance != null)
                        {
                            foreach (var atc in attendance)
                            {
                                <MudSelectItem Value="@atc.Id">@atc.InstructorName - @atc.Classs.Name - @atc.Date.ToString("yyyy-MM-dd")</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               ButtonType="ButtonType.Submit">
                        SAVE
                    </MudButton>
                </MudItem>

            </MudGrid>
        </EditForm>

    </DialogContent>

</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private AddStudentAttendanceDTO studentattendance = new();
    private List<GetStudentDTO> student = new();
    private List<GetAttendanceDTO> attendance = new();

    protected override async Task OnInitializedAsync()
    {
        var  std= await StudentService.GetAllStudentsAsync();
        if (student != null)
        {
            student = std;
            StateHasChanged();
        }
        
        var atc = await AttendanceService.GetAllAttendanceAsync();
        if (attendance != null)
        {
            attendance = atc;
            StateHasChanged();
        }

        @* var edu = await EducationLevelService.GetAllEducationLevelsAsync();
        if (edu != null)
        {
            educationlevel = edu;
            StateHasChanged();
        } *@
    }
    private async Task SaveStudentAttendanceAsync()
    {
        await StudentAttendanceService.AddStudentAttendanceAsync(studentattendance);

        MudDialog.Close(DialogResult.Ok(true));
    }
    
}
